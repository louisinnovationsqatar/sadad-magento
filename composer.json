{
    "name": "louis-innovations/sadad-magento",
    "description": "SADAD Payment Gateway module for Magento 2.4+ - Qatar's national payment gateway integration",
    "type": "magento2-module",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Louis Innovations",
            "email": "info@louis-innovations.com",
            "homepage": "https://www.louis-innovations.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "sadad",
        "qatar",
        "payment",
        "payment-gateway",
        "magento2",
        "magento",
        "checkout"
    ],
    "require": {
        "php": "^8.1",
        "louis-innovations/sadad-php-sdk": "^1.0 || dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "magento/framework": "^103.0 — Required when installed inside Magento 2",
        "magento/module-payment": "^100.4 — Required when installed inside Magento 2",
        "magento/module-sales": "^103.0 — Required when installed inside Magento 2",
        "magento/module-checkout": "^100.4 — Required when installed inside Magento 2",
        "magento/module-store": "^101.1 — Required when installed inside Magento 2",
        "magento/module-backend": "^102.0 — Required when installed inside Magento 2"
    },
    "autoload": {
        "psr-4": {
            "LouisInnovations\\Sadad\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sadad-php-sdk"
        }
    ],
    "extra": {
        "map": [
            ["*", "LouisInnovations/Sadad"]
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
